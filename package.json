  "scripts": {
    "start": "pm2 start build/init.js --name backend || pm2 reload backend",
    "prestart": "npm run build",
    "copyAll": "cp -R src/static build && cp -R src/views build",
    "build": "npm run clean && npm run build:server && npm run build:assets && npm run copyAll",
    "clean": "rm -rf build",
    "build:server": "babel src -d build --ignore 'src/assets','src/static','src/webpack.config.js'",
    "build:assets": "cd src && webpack --mode=production",
    "dev:server": "nodemon --exec babel-node src/init.js --delay 1 --ignore '.scss' --ignore 'static' ",
    "dev:assets": "cd src && webpack --mode=development -w",
    "deploy": "git pull && npm ci && npm run restart && pm2 save",
    "restart": "npm run build && PORT=8000 pm2 reload backend --update-env || PORT=8000 pm2 start build/init.js --name backend"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.1",
    "@babel/core": "^7.24.3",
    "@babel/node": "^7.23.9",
    "@babel/plugin-transform-runtime": "^7.24.3",
    "@babel/preset-env": "^7.24.3",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "mini-css-extract-plugin": "^2.8.1",
    "parcel-bundler": "^1.12.3",
