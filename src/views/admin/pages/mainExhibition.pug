extends ../../layouts/adminMain

block content
  body
    main.admin__main
      .admin__form-page#admin__mainExhibitionForm-page
        .layout-wrapper.layout-content-navbar
          .layout-container
            //- BEGIN: Sidebar menu
            include ../partials/adminSidebar
            //- END: Sidebar menu
            //- BEGIN: Layout container
            .layout-page
              //- BEGIN: Navbar
              include ../partials/adminNavbar
              //- END: Navbar
              //- BEGIN: Content wrapper
              .content-wrapper
                //- BEGIN: Content
                .container-xxl.flex-grow-1.container-p-y
                  h4.fw-bold.py-3.mb-3.admin__page-title=`${adminNameKo} 관리`
                  .row
                    .col-12.col-lg-7
                      .card
                        .card-body
                          form.browser-default-validation.admin__form(method="POST")
                            input(type="hidden" name="itemID" value=adminItem._id readonly required)
                            .mb-2
                              label.form-label.fw-bold(for='#monthlyAveragePayback') 월 평균 페이백 금액
                              input#monthlyAveragePayback.form-control(type='number' name="monthlyAveragePayback" value=adminItem.monthlyAveragePayback placeholder="월 평균 페이백 금액을 입력하세요" required)
                            .mb-2
                              label.form-label.fw-bold(for='#totalPayback') 사용자에게 돌려준 총 페이백 금액
                              input#totalPayback.form-control(type='number' name="totalPayback" value=adminItem.totalPayback placeholder="사용자에게 돌려준 총 페이백 금액을 입력하세요" required)
                            .row.mb-2
                              .col-6
                                label.form-label.fw-bold(for='#paybackRankingFirstID') 이번달 페이백 랭킹(1위) - 아이디
                                input#paybackRankingFirstID.form-control(type='text' name="paybackRankingFirstID" value=adminItem.paybackRanking[0].name placeholder="이번달 페이백 랭킹(1위)을 입력하세요" required)
                              .col-6
                                label.form-label.fw-bold(for='#paybackRankingFirstAmount') 이번달 페이백 랭킹(1위) - 금액(테더)
                                input#paybackRankingFirstAmount.form-control(type='number' name="paybackRankingFirstAmount" value=adminItem.paybackRanking[0].amount placeholder="이번달 페이백 랭킹(1위)을 입력하세요" required)
                            .row.mb-2
                              .col-6
                                label.form-label.fw-bold(for='#paybackRankingSecondID') 이번달 페이백 랭킹(2위) - 아이디
                                input#paybackRankingSecondID.form-control(type='text' name="paybackRankingSecondID" value=adminItem.paybackRanking[1].name placeholder="이번달 페이백 랭킹(2위)을 입력하세요" required)
                              .col-6
                                label.form-label.fw-bold(for='#paybackRankingSecondAmount') 이번달 페이백 랭킹(2위) - 금액(테더)
                                input#paybackRankingSecondAmount.form-control(type='number' name="paybackRankingSecondAmount" value=adminItem.paybackRanking[1].amount placeholder="이번달 페이백 랭킹(2위)을 입력하세요" required)
                            .row.mb-2
                              .col-6
                                label.form-label.fw-bold(for='#paybackRankingThirdID') 이번달 페이백 랭킹(3위) - 아이디
                                input#paybackRankingThirdID.form-control(type='text' name="paybackRankingThirdID" value=adminItem.paybackRanking[2].name placeholder="이번달 페이백 랭킹(3위)을 입력하세요" required)
                              .col-6
                                label.form-label.fw-bold(for='#paybackRankingThirdAmount') 이번달 페이백 랭킹(3위) - 금액(테더)
                                input#paybackRankingThirdAmount.form-control(type='number' name="paybackRankingThirdAmount" value=adminItem.paybackRanking[2].amount placeholder="이번달 페이백 랭킹(3위)을 입력하세요" required)
                            .row.mt-4
                              .col-12
                                button.btn.btn-success.waves-effect.waves-float.waves-light(type="submit") 수정하기
                //- END: Content
              //- END: Content wrapper
            //- END: Layout container
    //- Repeated scripts
    include ../partials/adminScripts
    //- Vendors JS
    script(src="/assets/vendor/libs/select2/select2.js")
    script(src="/assets/vendor/libs/bootstrap-select/bootstrap-select.js")
    script(src="/assets/vendor/libs/moment/moment.js")
    script(src="/assets/vendor/libs/flatpickr/flatpickr.js")
    script(src="/assets/vendor/libs/typeahead-js/typeahead.js")
    script(src="/assets/vendor/libs/tagify/tagify.js")
    script(src="/assets/vendor/libs/formvalidation/dist/js/FormValidation.min.js")
    script(src="/assets/vendor/libs/formvalidation/dist/js/plugins/Bootstrap5.min.js")
    script(src="/assets/vendor/libs/formvalidation/dist/js/plugins/AutoFocus.min.js")
    script(src="/assets/vendor/libs/cleavejs/cleave.js")
    script(src="/assets/vendor/libs/cleavejs/cleave-phone.js")
    script(src="/assets/vendor/libs/select2/select2.js")
    //- Main JS
    script(src="/assets/js/main.js")
    //- Page JS
    script(src="/assets/js/form-validation.js")
    script(src="/assets/js/form-layouts.js")