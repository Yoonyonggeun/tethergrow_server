extends ../../layouts/adminMain

block content
  body
    main.admin__main
      .admin__page#admin__event-page
        .layout-wrapper.layout-content-navbar
          .layout-container
            //- BEGIN: Sidebar menu
            include ../partials/adminSidebar
            //- END: Sidebar menu
            //- BEGIN: Layout container
            .layout-page
              //- BEGIN: Navbar
              include ../partials/adminNavbar
              //- END: Navbar
              //- BEGIN: Content wrapper
              .content-wrapper
                //- BEGIN: Content
                .container-xxl.flex-grow-1.container-p-y
                  h4.fw-bold.py-3.mb-3.admin__page-title=`${adminNameKo} 관리`
                    span.text-muted 내용이 보이지 않을 시 좌우로 스크롤 해보세요.
                  .row
                    .content-body
                      //- BEGIN: Basic Tables
                      #basic-table.row
                        .col-12
                          .card(style="overflow: scroll;")
                            //- BEGIN: Top button collections
                            .top__btn-items.card-body.pb-2
                              .top__btn-items-wrap
                                //- BEGIN: Search bar section
                                .top__btn-item.top__btn-item-search
                                  form.needs-validation(method="GET")
                                    .input-group
                                      select#basicSelect.form-control(name="searchKey")
                                        each option in searchArr
                                          if option.code === searchKey
                                            option(value=option.code selected)=option.title
                                          else
                                            option(value=option.code)=option.title
                                      input.form-control(type='search' name="searchValue" placeholder='검색어를 입력하세요...' value=searchValue aria-describedby='button-addon2')
                                      #button-addon2.input-group-append
                                        button.btn.btn-dark.waves-effect.search__btn(type="submit") 검색
                                //- END: Search bar section
                              .top__btn-items-wrap
                                //- BEGIN: Excel download button section
                                .top__btn-item.top__btn-item-excel
                                  button#excel__download-btn.btn.btn-secondary.buttons-collection.me-2.waves-effect.waves-light(type='button' name=`${adminNameKo}`)
                                    i.ti.ti-file-export.me-1
                                    | 엑셀 다운로드
                                  table#tableData(style='display: none;')
                                    thead
                                      tr
                                        th 번호
                                        th 거래소이름(한글)
                                        th 거래소이름(영어)
                                        th 제목
                                        th 설명
                                        th 링크
                                        th 시작일
                                        th 종료일
                                        th 생성일
                                        th 수정일
                                    tbody
                                      each item, index in adminItems
                                        tr
                                          td=index + 1
                                          td=item.exchangeID.nameKo
                                          td=item.exchangeID.nameEn
                                          td=item.title
                                          td=item.description
                                          td=item.link
                                          td=dateFormatYMDHm(item.startDate)
                                          td=dateFormatYMDHm(item.endDate)
                                          td=dateFormatYMDHm(item.createdAt)
                                          td=dateFormatYMDHm(item.updatedAt)
                                //- END: Excel download button section
                                //- BEGIN: Create button section
                                .top__btn-item.top__btn-item-create
                                  a.btn.btn-success.waves-effect.waves-float.waves-light(href=`${adminLink}/create`)
                                    i.ti.ti-plus.me-1
                                    span=`${adminNameKo} 등록`
                                //- END: Create button section
                              .top__btn-items-wrap
                                //- BEGIN: Delete button section
                                .top__btn-item.top__btn-item-delete
                                  button#select__delete-btn.btn.btn-warning.waves-effect.waves-light.me-2(type='button' data-db="event")
                                    i.ti.ti-trash.me-1
                                    | 선택 삭제
                                .top__btn-item.top__btn-item-delete
                                  button#all__delete-btn.btn.btn-danger.waves-effect.waves-light(type='button' data-db="event")
                                    i.ti.ti-trash.me-1
                                    | 전체 삭제
                                //- END: Delete button section
                              .top__btn-items-wrap
                                //- BEGIN: Sort link section
                                .top__btn-item.top__btn-item-sort
                                  ul.sorting__items
                                    each sortItem, index in sortArr
                                      if index !== 0
                                        span.bg-label-secondary &nbsp;&nbsp;|&nbsp;&nbsp;
                                      li.sorting__item
                                        a.sorting__item-link.bg-label-secondary(href=`?sort=${sortItem.code}` class=`${sortItem.code === sortCode ? "bg-label-primary fw-bold" : ""}`)=sortItem.title
                                //- END: Sort link section
                            //- END: Top button collections
                            //- BEGIN: Data table
                            .table-responsive
                              table.table.table-hover.table-striped.mb-0(style="min-width: 1620px;")
                                thead
                                  tr
                                    th(scope='col' style="width: 70px;")
                                      input.form-check-input(type='checkbox' id='checkAll')
                                    th.text-center(scope='col' style="width: 100px;") 순서변경
                                    th.text-center(scope='col' style="width: 80px;") 번호
                                    th.text-center(scope='col' style="width: 100px;") 수정/삭제
                                    th.text-center(scope='col' style="width: 100px;") 썸네일
                                    th(scope='col' style="width: 150px;") 거래소이름(한글)
                                    th(scope='col' style="width: 150px;") 거래소이름(영어)
                                    th(scope='col' style="width: 350px;") 제목
                                    th(scope='col' style="width: 250px;") 링크
                                    th(scope='col' style="width: 200px;") 시작일
                                    th(scope='col' style="width: 200px;") 종료일
                                    th(scope='col' style="width: 160px;") 생성일
                                    th(scope='col' style="width: 160px;") 수정일
                                tbody.list-group.list-group-flush(id="handle-list-2" style="display: revert; width: 100%;" data-model="Event")
                                  each item, index in adminItems
                                    tr.list-group-item(style="display: revert; width: 100%;" data-id=item._id)
                                      td
                                        input.form-check-input(type='checkbox' data-id=`${item._id}`)
                                      td.text-center(scope='col')
                                        i.ti.ti-menu-2.drag-handle(style="cursor: grab;")
                                      td.text-center(scope='col')
                                        span.font-weight-bold=index + 1
                                      td.text-center(scope='col')
                                        .td__items
                                          a.td__item(href=`${adminLink}/update?itemID=${item._id}`)
                                            i.ti.ti-edit
                                          a.td__item(href=`${adminLink}/delete?itemID=${item._id}` onclick="return confirm('정말 삭제 하시겠습니까?')")
                                            i.ti.ti-trash
                                      td.text-center(scope='col')
                                        img.img-fluid.d-flex.mt-0.mb-0.mr-auto.my-4.rounded(src=item.thumbnail style="width: 100%; max-width: 400px;")
                                      td.ellipsis__td(scope='col')=item.exchangeID.nameKo
                                      td.ellipsis__td(scope='col')=item.exchangeID.nameEn
                                      td.ellipsis__td(scope='col')=item.title
                                      td.ellipsis__td(scope='col')
                                        a.td__item(href=item.link target="_blank")=item.link
                                          i.ti.ti-external-link
                                      td.ellipsis__td(scope='col')=dateFormatYMDHm(item.startDate)
                                      td.ellipsis__td(scope='col')=dateFormatYMDHm(item.endDate)
                                      td.ellipsis__td(scope='col')=dateFormatYMDHm(item.createdAt)
                                      td.ellipsis__td(scope='col')=dateFormatYMDHm(item.updatedAt)
                            //- END: Data table
                      //- END: Basic Tables
                //- END: Content
              //- END: Content wrapper
            //- END: Layout container
    //- Repeated scripts
    include ../partials/adminScripts
    //- Vendors JS
    script(src="/assets/vendor/libs/sortablejs/sortable.js")
    //- Main JS
    script(src="/assets/js/main.js")
    //- Page JS
    script(src="/assets/js/extended-ui-drag-and-drop.js")