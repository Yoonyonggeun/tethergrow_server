extends ../../layouts/adminMain

block content
  body
    main.admin__main
      //- 데이터 업로드 시 로딩 처리
      .admin__loading#admin__loading
        img(src=`${imgPath}/admin/loading.gif` alt="loading")
        p#loading__desc
      .admin__form-page#admin__uidForm-page(data-btc=btc.exchangeRate data-eth=eth.exchangeRate data-mx=mx.exchangeRate)
        .layout-wrapper.layout-content-navbar
          .layout-container
            //- BEGIN: Sidebar menu
            include ../partials/adminSidebar
            //- END: Sidebar menu
            //- BEGIN: Layout container
            .layout-page
              //- BEGIN: Navbar
              include ../partials/adminNavbar
              //- END: Navbar
              //- BEGIN: Content wrapper
              .content-wrapper
                //- BEGIN: Content
                .container-xxl.flex-grow-1.container-p-y
                  h4.fw-bold.py-3.mb-3.admin__page-title UID 데이터 업로드
                  .row
                    .col-12.col-lg-8
                      .card
                        .card-body
                          form.browser-default-validation.admin__form(method="POST")
                            .col-12
                              h5.fw-semibold 1. 환율 입력
                              hr.mt-0
                            .mb-4
                              label.form-label.fw-bold(for="btc") BTC to USDT&nbsp;&nbsp;
                              label.form-label.text-danger.fw-bold=`[마지막 업데이트 일시 : ${dateFormatYMDHms(btc.updatedAt)}]`
                              .row
                                .col-12.col-md-8.mb-2
                                  input#btc.form-control(type="number" name="btc" value=btc.exchangeRate required)
                                .col-12.col-md-4
                                  button#submit__btc.btn.btn-primary(type="button" style="width: 100%;") BTC 환율 수정
                            .mb-4
                              label.form-label.fw-bold(for="eth") ETH to USDT&nbsp;&nbsp;
                              label.form-label.text-danger.fw-bold=`[마지막 업데이트 일시 : ${dateFormatYMDHms(eth.updatedAt)}]`
                              .row
                                .col-12.col-md-8.mb-2
                                  input#eth.form-control(type="number" name="eth" value=eth.exchangeRate required)
                                .col-12.col-md-4
                                  button#submit__eth.btn.btn-primary(type="button" style="width: 100%;") ETH 환율 수정
                            .mb-4
                              label.form-label.fw-bold(for="mx") MX to USDT&nbsp;&nbsp;
                              label.form-label.text-danger.fw-bold=`[마지막 업데이트 일시 : ${dateFormatYMDHms(mx.updatedAt)}]`
                              .row
                                .col-12.col-md-8.mb-2
                                  input#mx.form-control(type="number" name="mx" value=mx.exchangeRate required)
                                .col-12.col-md-4
                                  button#submit__mx.btn.btn-primary(type="button" style="width: 100%;") MX 환율 수정
                            .col-12
                              h5.fw-semibold.mb-0 2. UID 업로드
                              label.form-label.text-danger.fw-bold 중복하여 업로드 하지 않도록 주의해주세요.
                              hr.mt-0
                            each exchange in exchanges
                              .mb-4
                                label.form-label.fw-bold(for=`${exchange.nameEn.toLowerCase().replace(".", "")}`)=`${exchange.nameEn} 업로드`
                                label.form-label.text-danger.fw-bold(style="margin-left: 5px;")=`[마지막 업로드 일시 : ${exchange.lastUploadUidAt ? dateFormatYMDHms(exchange.lastUploadUidAt) : "없음"}]`
                                .row
                                  .col-12.col-md-7.mb-2
                                    input.form-control(type="file" id=exchange.nameEn.toLowerCase().replace(".", "") name=`${exchange.nameEn.toLowerCase().replace(".", "")}` required)
                                  .col-12.col-md-5
                                    if isToday(exchange.lastUploadUidAt)
                                      button.btn.btn-success.upload__uid-btn(type="button" style="width: 100%;" disabled)=`${exchange.nameEn} 업로드 완료`
                                    else
                                      .row
                                        .col-12
                                          button.btn.btn-primary.upload__uid-btn(type="button" style="width: 100%;" id=`submit__${exchange.nameEn.toLowerCase().replace(".", "")}` data-id=exchange._id)=`${exchange.nameEn} 업로드`
                            .col-12
                              h5.fw-semibold.mb-0 3. API 실행
                              label.form-label.text-danger.fw-bold ※ 아래 내용을 반드시 숙지 후 실행해주세요.
                                br
                                | 신규 가입자 UID를 등록 후 실행해주세요.
                                br
                                | 호출 횟수 제한으로 인해 시간이 오래 걸릴 수 있습니다.
                                br
                                | 안정적인 네트워크 환경에서 실행해 주시고,
                                br
                                | API 실행 후 새로고침을 절대 하지 마세요.
                              hr.mt-0
                            .col-12
                              .mb-2
                                label.form-label.fw-bold(for="okxUid") OKX 신규 가입자 UID
                                .row
                                  .col-12.col-md-8.mb-2
                                    input#okxUid.form-control.mb-2(type="number" name="okxUid" placeholder="OKX 신규 가입자 UID를 입력해주세요" required)
                                    p.mb-0(style="font-weight: bold;") 신규 등록한 UID (새로고침 시 리스트는 초기화됩니다.)
                                    ul.uploaded__uid-items#uploaded__uid-items-okx(style="padding: 0; margin: 0;")
                                  .col-12.col-md-4
                                    button#submit__okxUid.btn.btn-primary(type="button" style="width: 100%;" data-id=okxExchange._id) 등록
                              .mb-4
                                label.form-label.fw-bold(for="okx") OKX API 실행
                                label.form-label.text-danger.fw-bold(style="margin-left: 5px;")=`[마지막 실행 일시 : ${okxExchange.lastUploadUidAt ? dateFormatYMDHms(okxExchange.lastUploadUidAt) : "없음"}]`
                                .row
                                  .col-12
                                    button.btn.btn-primary#submit__okx-api(type="button" style="width: 100%;" data-id=okxExchange._id)=`${okxExchange.nameEn} API 실행`
                //- END: Content
              //- END: Content wrapper
            //- END: Layout container
    //- Repeated scripts
    include ../partials/adminScripts
    //- Vendors JS
    script(src="/assets/vendor/libs/select2/select2.js")
    script(src="/assets/vendor/libs/bootstrap-select/bootstrap-select.js")
    script(src="/assets/vendor/libs/moment/moment.js")
    script(src="/assets/vendor/libs/flatpickr/flatpickr.js")
    script(src="/assets/vendor/libs/typeahead-js/typeahead.js")
    script(src="/assets/vendor/libs/tagify/tagify.js")
    script(src="/assets/vendor/libs/formvalidation/dist/js/FormValidation.min.js")
    script(src="/assets/vendor/libs/formvalidation/dist/js/plugins/Bootstrap5.min.js")
    script(src="/assets/vendor/libs/formvalidation/dist/js/plugins/AutoFocus.min.js")
    script(src="/assets/vendor/libs/cleavejs/cleave.js")
    script(src="/assets/vendor/libs/cleavejs/cleave-phone.js")
    script(src="/assets/vendor/libs/select2/select2.js")
    //- Main JS
    script(src="/assets/js/main.js")
    //- Page JS
    script(src="/assets/js/form-validation.js")
    script(src="/assets/js/form-layouts.js")
